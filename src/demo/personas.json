          "plain": "Approve a timesheet",
          "why": "no such permission",
          "expect": 403
        },
        {
          "plain": "See cost rates",
          "why": "field visibility",
          "expect": "field absent"
        },
        {
          "plain": "See another company",
          "why": "tenant scope",
          "expect": 404
        },
        {
          "plain": "Write to your own company",
          "why": "read-only company",
          "expect": 404
        }
      ],
      "tryThis": [
        {
          "call": "GET /timesheets",
          "expect": 200,
          "why": "the control — your own rows, in both companies you can read"
        },
        {
          "call": "POST /timesheets",
          "body": {
            "employeeId": 81,
            "workDate": "2026-08-12",
            "startAt": "2026-08-12T07:00:00Z",
            "endAt": "2026-08-12T15:00:00Z",
            "hours": 8,
            "status": "submitted",
            "note": "Sandbox shift"
          },
          "expect": 201,
          "why": "employee 81 is the Scratch Sandbox worker — the only one in your write scope"
        },
        {
          "call": "GET /timesheets/1042",
          "expect": 404,
          "why": "Ben's row: same company, same department, different owner"
        },
        {
          "call": "POST /timesheets/1041/approve",
          "body": {
            "auditMessage": "Attempting an approval I hold nowhere."
          },
          "expect": 403,
          "why": "no approve permission anywhere, so no row is ever loaded"
        },
        {
          "call": "GET /timesheets/1043",
          "expect": 404,
          "why": "a Kestrel row, and a valid id"
        }
      ]
    }
